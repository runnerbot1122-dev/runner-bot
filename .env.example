# Provedores de conversa com IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# O comando 7gpt usa Groq como provedor rápido
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Comandos 7claude e 7cloude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest

# Fallback opcional para qualquer conversa
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Fallback legado/opcional
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
