const solicitacoes = require("../../database/solicitacoes");
const replyNYX = require("../../utils/replyNYX");

module.exports = {
    name: "aceitar",
    description: "Aceita todas as solicitações de entrada pendentes",
    category: "admin",
    adminOnly: true,
    async execute(ctx) {
        const { sock, chat, isAdmin } = ctx;

        if (!isAdmin) return replyNYX(ctx, "❌ Apenas administradores.", "user");

        const pendentesObj = solicitacoes.getPendentes(chat);
        const pendentes = Object.keys(pendentesObj || {});

        if (pendentes.length === 0) {
            return replyNYX(ctx, "❌ Não há nenhuma solicitação pendente neste grupo.", "user");
        }

        await ctx.react("⏳");
        let aceitos = 0;

        // Passa por todos os pendentes e tenta aprovar
        for (const alvo of pendentes) {
            try {
                await sock.groupRequestParticipantsUpdate(chat, [alvo], "approve");
                solicitacoes.remover(chat, alvo);
                aceitos++;
            } catch (e) {
                console.error(`[ACEITAR] Falha ao aprovar ${alvo}:`, e.message);
            }
        }

        await ctx.react("✅");
        return replyNYX(ctx, `✅ *SOLICITAÇÕES ACEITAS*\n\n*${aceitos}* membro(s) foram aprovados no grupo.`, "user");
    }
};