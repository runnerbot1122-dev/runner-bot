const solicitacoes = require("../../database/solicitacoes");
const replyNYX = require("../../utils/replyNYX");

module.exports = {
    name: "recusar",
    description: "Recusa todas as solicitações de entrada pendentes",
    category: "admin",
    adminOnly: true,
    async execute(ctx) {
        const { sock, chat, isAdmin } = ctx;

        if (!isAdmin) return replyNYX(ctx, "❌ Apenas administradores.", "user");

        const pendentesObj = solicitacoes.getPendentes(chat);
        const pendentes = Object.keys(pendentesObj || {});

        if (pendentes.length === 0) {
            return replyNYX(ctx, "❌ Não há nenhuma solicitação pendente neste grupo.", "user");
        }

        await ctx.react("⏳");
        let recusados = 0;

        for (const alvo of pendentes) {
            try {
                await sock.groupRequestParticipantsUpdate(chat, [alvo], "reject");
                solicitacoes.remover(chat, alvo);
                recusados++;
            } catch (e) {
                console.error(`[RECUSAR] Falha ao recusar ${alvo}:`, e.message);
            }
        }

        await ctx.react("✅");
        return replyNYX(ctx, `✅ *SOLICITAÇÕES RECUSADAS*\n\n*${recusados}* membro(s) foram recusados no grupo.`, "user");
    }
};