const ownerOnly=require('../../utils/ownerOnly');const db=require('../../database/securityGroups');const {getTarget}=require('../../utils/checkTarget');
module.exports={name:['verificado-global','verificadoglobal'],description:'Marca ou desmarca usuário como verificado globalmente',execute:async(ctx)=>{ownerOnly(ctx);const target=getTarget(ctx);if(!target)return ctx.reply('Marque/responda ao usuário e informe on ou off.');const action=String(ctx.args?.[0]||'').toLowerCase();if(!['on','off','add','del','remover','adicionar'].includes(action))return ctx.reply('Uso: 7verificado-global on/off com usuário marcado.');const enabled=['on','add','adicionar'].includes(action);db.setGlobalVerified(target,enabled);await ctx.replyNYX(enabled?'✅ Usuário marcado como verificado globalmente.':'Verificação global removida.','bot');}};
